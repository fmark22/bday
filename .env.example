# Vercel: connect Upstash Redis in Storage. Never expose this as VITE_*.
# The integration normally injects REDIS_URL (or KV_URL) automatically.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379

# Optional. Leave unset when web and realtime API use the same Vercel origin.
# VITE_SOCKET_URL=https://your-separate-realtime-server.example.com
# CLIENT_ORIGIN=https://your-frontend.vercel.app

# For local Redis testing, use an isolated namespace.
# BDAY_REDIS_NAMESPACE=bday:local-test
