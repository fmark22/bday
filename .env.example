# Vercel project environment variable. Replace with the real backend origin.
# Vite embeds it at BUILD time: redeploy the frontend after changing it.
VITE_SOCKET_URL=https://your-realtime-server.example.com

# Backend hosting environment variables (do not set these only in Vercel).
NODE_ENV=production
CLIENT_ORIGIN=https://your-frontend.vercel.app
# PORT is normally supplied by the backend hosting provider.
